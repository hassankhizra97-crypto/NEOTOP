Screen {
    background: #001c03;
    color: #f5f5f5;
}

Grid {
    grid-size: 2 3;
    grid-gutter: 1;
    padding: 1;
}

CpuWidget {
    border: dashed #39ff14;
    padding: 1;
    layout: vertical;
    height:auto;
    width:50;
}
MemoryWidget {
    border: dashed #39ff14;
    padding: 1;
    layout: vertical;
    height:auto;
    width:50;
}

ProcessTableWidget {
    border: dashed #39ff14;
    padding: 1;
    layout: vertical;
    height:auto;
    width:50;
}

DiskWidget {
    border: dashed #39ff14;
    padding: 1;
    layout: vertical;
    height:auto;
    width:50;
}

NetworkWidget {
    border: dashed #39ff14;
    padding: 1;
    layout: vertical;
    height:auto;
    width:50;
}
CoreWidget{
    border: dashed #39ff14;
    padding: 1;
    layout: vertical;
    height:auto;
    width:50;
}


/* =========================
   Titles
   ========================= */

#cpu-title,
#memory-title,
#process-title,
#disk-title,
#network-title {
    text-style: bold;
    margin-bottom: 1;
}


/* =========================
   CPU
   ========================= */

#cpu-title {
    color: #38f8ff;
}

#cpu-usage {
    color: #38f8ff;
    text-align: center;
    text-style: bold;
    width: 100%;

}

#cpu-progress {
    margin: 1 2;
    width:90%;

}

#cpu-history-label {
    color: #d24ded;
    margin-top: 1;
}



.core-usage {
    color: #39ff14;
}


/* =========================
   Memory
   ========================= */

#memory-title {
    color: #ff00ff;
}

#memory-total,
#memory-used,
#memory-available,
#memory-percent {
    margin-bottom: 1;
}

#memory-percent {
    color: #00f5ff;
}


/* =========================
   Processes
   ========================= */

#process-title {
    color: #cc11f0;
}

#process-table {
    height: 1fr;
}


/* =========================
   Disk
   ========================= */

#disk-title {
    color: #39ff14;
}

#disk-read {
    color: #00f5ff;
}

#disk-write {
    color: #ff00ff;
}


/* =========================
   Network
   ========================= */

#network-title {
    color: #ffff00;
}

#network-sent {
    color: #39ff14;
}

#network-received {
    color: #ff00ff;
}


#cpu-sparkline {
        height: 5;
        margin: 0 0 1 0;
        color:#ff00ff;
}

#core-title{
    color: #38f8ff;
    text-align: center;
    text-style: bold;
    width: 100%;
    margin-bottom: 1;
}

.core-row {
        height: 1;
        layout: horizontal;
    }

.core-label {
    width: 10;
    color: #38f8ff;
    }

.core-progress {
    width: 1fr;}
    